# Copie para .env (NUNCA commitar). Na Vercel, cadastre como Environment Variables.
# Supabase de ANÚNCIOS: meta_campaigns, meta_adsets, meta_adset_daily (sincronizadas do Meta por outro processo) e leads do formulário.
# O dashboard NÃO chama a API do Meta.
META_SUPABASE_URL=            # https://xxxx.supabase.co
META_SUPABASE_SERVICE_ROLE_KEY= # só no backend, nunca no frontend
# Supabase de WHATSAPP (projeto separado): wa_mensagens e wa_analises, gravadas pelo n8n
WA_SUPABASE_URL=
WA_SUPABASE_SERVICE_ROLE_KEY=
# Supabase do PAINEL (opcional): tabelas criadas por este projeto (ghl_oportunidades, ghl_usuarios, ghl_contatos,
# ghl_sync, wa_auditorias, ig_analises). Sem estas variáveis, o painel procura essas tabelas no projeto de WhatsApp.
GHL_SUPABASE_URL=
GHL_SUPABASE_SERVICE_ROLE_KEY=
# Opcional: força dados de demonstração
MOCK=0
PORT=8787

# Login do dashboard (obrigatório em produção; sem isso o acesso fica bloqueado)
DASHBOARD_SESSION_SECRET=     # gere com: openssl rand -hex 32
# AUTH_DISABLED=1             # SÓ para desenvolvimento local; nunca em produção
